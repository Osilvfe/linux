config VIDEO_QCOM_CAMERA_ICP
	tristate "Qualcomm Camera ICP BPS V4L2 driver"
	depends on VIDEO_DEV
	depends on QCOM_CAMERA_ICP
	select V4L2_MEM2MEM_DEV
	select VIDEOBUF2_DMA_CONTIG
	help
	  Expose the Qualcomm Camera ICP Bayer Processing System as a V4L2
	  memory-to-memory image processor.
