config VIDEO_QCOM_CAMERA_ICP
	tristate "Qualcomm Camera ICP BPS V4L2 driver"
	depends on VIDEO_DEV
	depends on QCOM_CAMERA_ICP
	select V4L2_MEM2MEM_DEV
	select VIDEOBUF2_DMA_SG
	help
	  Expose the Qualcomm Camera ICP Bayer Processing System as a V4L2
	  memory-to-memory image processor.

config VIDEO_QCOM_CAMERA_NATIVE
	tristate "Caihong native V4L2 camera capture (experimental)"
	depends on VIDEO_DEV && VIDEO_QCOM_CAMSS && QCOM_CAMERA_ICP
	select VIDEOBUF2_DMA_SG
	help
	  Connect Caihong sensors through CAMSS and Camera ICP BPS to ordinary
	  NV12 capture nodes. This experimental driver shares the hardware with
	  libcamera and requires exclusive access to each sensor pipeline.
